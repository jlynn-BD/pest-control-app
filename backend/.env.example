DATABASE_URL="postgresql://user:password@host:5432/dbname"
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"
JWT_REFRESH_SECRET="change-me-to-a-different-long-random-string"
PORT=4000
STORAGE_DIR="./storage"

# --- Sign-in security (all optional; sensible defaults) ---
# MFA_ENFORCED=true            # every account needs a second step; "false" is an emergency off-switch
# SESSION_MAX_AGE_DAYS=30      # a remembered session ends this long after sign-in, no matter how often it's used
# CORS_ORIGINS=https://pestapp-web.onrender.com   # comma-separated web origins allowed to call the API
# AUTH_RATE_LIMIT_MAX=40       # sign-in requests per IP per 15 minutes
# MFA_ENCRYPTION_KEY=          # defaults to JWT_REFRESH_SECRET; encrypts stored authenticator secrets

# --- Text-message codes via Twilio (omit all of these to offer authenticator apps only) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+15551234567         # or use TWILIO_MESSAGING_SERVICE_SID instead
# SMS_MODE=console                        # LOCAL TESTING ONLY: prints codes to the server log; ignored when NODE_ENV=production
