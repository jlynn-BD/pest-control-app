{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "lib": ["ES2022"],
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "baseUrl": ".",
    "paths": {
      "@pest-app/shared": ["../shared/src/index.ts"],
      "@pest-app/shared/*": ["../shared/src/*"]
    }
  },
  "include": ["src/**/*.ts", "prisma/**/*.ts"]
}
